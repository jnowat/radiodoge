{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RadioDoge",
  "version": "0.3.40",
  "identifier": "com.jnowat.radiodoge",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RadioDoge",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/doge-radio.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© 2026 RadioDoge Contributors",
    "category": "Finance",
    "shortDescription": "Wireless P2P Dogecoin transactions over LoRa radio",
    "longDescription": "RadioDoge lets you send and receive Dogecoin over LoRa radio waves with no internet required. Uses Heltec ESP32 boards and the official Dogecoin network.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "RadioDoge Contributors",
    "homepage": "https://github.com/jnowat/radiodoge"
  }
}
